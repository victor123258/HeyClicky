{
  "name": "heyclicky-community",
  "version": "1.8.0",
  "description": "Independent screen-aware AI buddy for Windows",
  "main": "src/main/index.js",
  "author": "HeyClicky Community contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win --x64",
    "preview": "node scripts/preview.js",
    "build:visuals": "node scripts/build-visuals.js",
    "precheck": "npm run build:visuals",
    "prestart": "npm run build:visuals",
    "prepreview": "npm run build:visuals",
    "predist": "npm run build:visuals"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0"
  },
  "build": {
    "appId": "org.heyclicky.community",
    "productName": "HeyClicky Community",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "scripts/*.ps1",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "scripts/*.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "HeyClicky-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "HeyClicky-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "docx": "^9.15.0",
    "three": "^0.187.0"
  }
}
